   return 0;
 }
 
+int protectpg(pde_t *pgdir, void* addr, int len){
+  pte_t* pte;
+
+  for(int i = 0; i < len; i++, addr += PGSIZE){
+
+    if((pte = walkpgdir(pgdir, addr, 0)) == 0)
+    return -1;
+
+    (*pte) &= ~PTE_W;
+  }
+  lcr3(V2P(myproc()->pgdir));
+  return 0;
+}
+
+int unprotectpg(pde_t *pgdir, void* addr, int len){
+
+  pte_t* pte;
+
+  for(int i = 0; i < len; i++, addr += PGSIZE){
+
+    if((pte = walkpgdir(pgdir, addr, 0)) == 0)
+    return -1;
+
+    (*pte) |= PTE_W;
+  }
+  lcr3(V2P(myproc()->pgdir));
+  return 0;
+
+}
