index 0686d29..8142aa8 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -7,6 +7,64 @@
 #include "mmu.h"
 #include "proc.h"
 
+int 
+sys_mprotect(void)
+{
+  void* addr;
+  int len;
+
+  if(argptr(0, (char**) &addr, sizeof(void*)) < 0)
+    return -1;
+  if(argint(1, &len) < 0)
+    return -1;
+
+  // cprintf("addr: %d\n", (uint*) addr);
+  // cprintf("len: %d\n", len);
+  // cprintf("limit: %d\n", (uint) addr + len*PGSIZE);
+  // cprintf("size: %d\n", myproc()->sz);
+  if(len <= 0)
+    return -1;
+   
+  if(PGROUNDDOWN((uint) addr) != (uint) addr){
+    return -1;
+  }
+
+  if((uint) addr + len*PGSIZE > myproc()->sz){
+    return -1;
+  }
+
+  return protectpg(myproc()->pgdir, addr, len);
+}
+
+int 
+sys_munprotect(void)
+{
+  void* addr;
+  int len;
+
+  if(argptr(0, (char**) &addr, sizeof(void*)) < 0)
+    return -1;
+  if(argint(1, &len) < 0)
+    return -1;
+
+  // cprintf("addr: %d\n", (uint*) addr);
+  // cprintf("len: %d\n", len);
+  // cprintf("limit: %d\n", (uint) addr + len*PGSIZE);
+  // cprintf("size: %d\n", myproc()->sz);
+  if(len <= 0)
+    return -1;
+   
+  if(PGROUNDDOWN((uint) addr) != (uint) addr){
+    return -1;
+  }
+
+  if((uint) addr + len*PGSIZE > myproc()->sz){
+    return -1;
+  }
+
+  return unprotectpg(myproc()->pgdir, addr, len);
+}
